<?xml version="1.0"?>
<ruleset name="Project">
  <description>Project standard: PSR-12 + Slevomat quality + PHPCompatibility</description>

  <arg name="basepath" value="."/>
  <arg name="colors"/>
  <arg name="parallel" value="8"/>
  <arg name="cache" value=".phpcs-cache"/>
  <arg value="ps"/>

  <file>src</file>
  <file>tests</file>

  <exclude-pattern>vendor/*</exclude-pattern>
  <exclude-pattern>var/*</exclude-pattern>
  <exclude-pattern>cache/*</exclude-pattern>
  <exclude-pattern>build/*</exclude-pattern>

  <!-- Baseline style -->
  <rule ref="PSR12">
    <exclude name="Squiz.WhiteSpace.ScopeClosingBrace.ContentBefore"/>
    <exclude name="Generic.Files.LineLength.TooLong"/>
  </rule>

  <!-- Enforce supported PHP versions in production -->
  <!-- set this to what you actually support -->
  <config name="testVersion" value="8.2-8.4"/>
  <rule ref="PHPCompatibility"/>

  <!-- Enforce "one class/interface/trait per file" -->
  <rule ref="Generic.Files.OneObjectStructurePerFile"/>

  <!-- “No surprise” namespace hygiene -->
  <rule ref="SlevomatCodingStandard.Namespaces.UnusedUses"/>
  <rule ref="SlevomatCodingStandard.Namespaces.AlphabeticallySortedUses"/>

  <!-- Prefer strict typing (matches your .cursorrules) -->
  <!-- <rule ref="SlevomatCodingStandard.TypeHints.DeclareStrictTypes"/> -->

  <!-- Keep signatures explicit -->
  <rule ref="SlevomatCodingStandard.TypeHints.ParameterTypeHint"/>
  <rule ref="SlevomatCodingStandard.TypeHints.ReturnTypeHint"/>
  <rule ref="SlevomatCodingStandard.TypeHints.PropertyTypeHint"/>

  <!-- A couple of pragmatic control-structure rules -->
  <rule ref="SlevomatCodingStandard.ControlStructures.DisallowYodaComparison"/>
  <rule ref="SlevomatCodingStandard.ControlStructures.RequireNullCoalesceOperator"/>
</ruleset>
